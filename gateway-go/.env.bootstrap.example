# Temporary single-upstream bootstrap mode for the Go v2 data plane.
# Copy this file to .env.bootstrap, replace all placeholders, and never commit it.

SYNTROPY_GATEWAY_ADDR=:8081
SYNTROPY_GATEWAY_SHUTDOWN_TIMEOUT=10s
SYNTROPY_GATEWAY_READ_HEADER_TIMEOUT=5s
SYNTROPY_GATEWAY_IDLE_TIMEOUT=120s

SYNTROPY_UPSTREAM_DIAL_TIMEOUT=10s
SYNTROPY_UPSTREAM_TLS_HANDSHAKE_TIMEOUT=10s
SYNTROPY_UPSTREAM_RESPONSE_HEADER_TIMEOUT=60s
SYNTROPY_UPSTREAM_IDLE_CONN_TIMEOUT=90s
SYNTROPY_UPSTREAM_MAX_IDLE_CONNS=100
SYNTROPY_UPSTREAM_MAX_IDLE_CONNS_PER_HOST=20

SYNTROPY_BOOTSTRAP_ENABLED=true
SYNTROPY_BOOTSTRAP_CLIENT_TOKEN=replace-with-at-least-16-random-characters
SYNTROPY_BOOTSTRAP_MODEL_ALIAS=smart-chat
SYNTROPY_BOOTSTRAP_UPSTREAM_BASE_URL=https://api.example.com/v1
SYNTROPY_BOOTSTRAP_UPSTREAM_MODEL=provider-model-id
SYNTROPY_BOOTSTRAP_UPSTREAM_API_KEY=replace-with-provider-key
SYNTROPY_BOOTSTRAP_UPSTREAM_AUTH_HEADER=Authorization
SYNTROPY_BOOTSTRAP_UPSTREAM_AUTH_SCHEME=Bearer
SYNTROPY_BOOTSTRAP_UPSTREAM_CHAT_PATH=/v1/chat/completions

# Enable only capabilities confirmed for the chosen upstream.
SYNTROPY_BOOTSTRAP_SUPPORTS_STREAMING=false
SYNTROPY_BOOTSTRAP_SUPPORTS_TOOLS=false
SYNTROPY_BOOTSTRAP_SUPPORTS_PARALLEL_TOOLS=false
SYNTROPY_BOOTSTRAP_SUPPORTS_MULTIMODAL_INPUT=false
SYNTROPY_BOOTSTRAP_SUPPORTS_REASONING=false
SYNTROPY_BOOTSTRAP_SUPPORTS_STRUCTURED_OUTPUT=false
